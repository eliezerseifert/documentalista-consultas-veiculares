---
// Header.astro — Componente de Cabeçalho do Documentalista Consultas
import Button from './Button.astro';
import { Image } from 'astro:assets';
import logoImg from '../assets/images/logo.svg';

const pathname = Astro.url.pathname;
const isPainel = pathname.startsWith('/painel');
const logoHref = isPainel ? '/painel' : '/';
---

<header transition:persist class="sticky top-0 z-[100] w-full h-[76px] lg:h-[88px] flex items-center justify-between px-4 sm:px-6 lg:px-[6%] border-b border-slate-100 bg-white/90 backdrop-blur-md transition-all">
  <div class="flex items-center gap-2.5 sm:gap-3">
    <!-- Botão Hambúrguer Mobile (Lado Esquerdo da Logo) -->
    <button 
      type="button" 
      id="mobile-menu-toggle"
      onclick="toggleMobileMenu()"
      class="flex lg:hidden items-center justify-center p-1 text-[#124A6E] hover:text-[#3DB5B4] transition-colors focus:outline-none flex-shrink-0"
      aria-label="Abrir Menu de Navegação"
    >
      <svg class="w-7 h-7 text-[#124A6E]" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M4 6h16M4 12h16M4 18h16"></path>
      </svg>
    </button>

    <!-- Logo SVG Oficial -->
    <a href={logoHref} class="flex items-center gap-2">
      <Image src={logoImg} alt="DOCUMENTALISTA CONSULTAS" class="h-9 sm:h-10 lg:h-12 w-auto" loading="eager" fetchpriority="high" />
    </a>
    <span class="text-[10px] font-mono-code bg-[#3DB5B4]/10 text-[#124A6E] border border-[#3DB5B4]/30 px-2.5 py-0.5 rounded-full font-bold uppercase tracking-wider hidden sm:inline-block">
      Consultas Veiculares
    </span>
  </div>

  <!-- Navegação Desktop -->
  <nav class="hidden lg:flex text-xs font-semibold uppercase tracking-wider text-slate-600 gap-x-8 items-center">
    <a href="/#planos" class="hover:text-[#3DB5B4] transition-colors py-1">Consultas e Pacotes</a>
    <a href="/#como-funciona" class="hover:text-[#3DB5B4] transition-colors py-1">Como Funciona</a>
    <a href="/#garantia" class="hover:text-[#3DB5B4] transition-colors py-1">Garantia</a>
  </nav>

  <div class="flex items-center gap-2 sm:gap-3">
    <!-- Botão Entrar / Login / Painel -->
    <button 
      type="button" 
      onclick="handleHeaderLoginClick()" 
      class="flex items-center gap-1.5 text-xs font-bold text-[#124A6E] bg-white hover:bg-slate-50 p-2 sm:py-2.5 sm:px-3.5 rounded-xl border border-slate-200 transition-all hover:border-[#3DB5B4]"
      title="Entrar na Minha Conta"
      aria-label="Entrar na Minha Conta"
    >
      <span class="iconify w-4 h-4 text-[#3DB5B4]" data-icon="solar:user-bold"></span>
      <span id="header-user-label" class="hidden sm:inline">Entrar</span>
    </button>

    <!-- Botão de Carrinho com Contador Badge -->
    <button onclick="openCartDrawer()" 
            class="relative flex items-center gap-2 text-xs font-semibold text-[#124A6E] bg-slate-100 hover:bg-[#3DB5B4]/15 p-2 sm:py-2.5 sm:px-4 rounded-xl border border-slate-200 transition-all"
            title="Ver Carrinho"
            aria-label="Abrir Carrinho de Compras">
      <span class="iconify w-4 h-4 text-[#3DB5B4]" data-icon="solar:cart-large-bold"></span>
      <span class="hidden sm:inline">Carrinho</span>
      <span id="cart-badge" class="bg-[#3DB5B4] text-white text-[10px] font-mono-code font-bold w-5 h-5 rounded-full flex items-center justify-center">0</span>
    </button>

    <Button href="#hero-form" variant="primary" size="sm" icon="solar:magnifier-linear" class="hidden sm:flex">
      Consultar Placa
    </Button>
  </div>
</header>

<!-- OVERLAY E MENU MOBILE DRAWER -->
<div 
  id="mobile-menu-backdrop" 
  onclick="toggleMobileMenu(false)" 
  class="fixed inset-0 bg-[#124A6E]/50 backdrop-blur-sm z-[140] hidden transition-opacity lg:hidden"
></div>

<div 
  id="mobile-menu-drawer" 
  class="fixed top-[76px] inset-x-0 bg-white border-b border-slate-200 shadow-2xl z-[150] hidden transition-all duration-300 transform -translate-y-4 opacity-0 lg:hidden"
>
  <div class="p-5 space-y-4">
    <nav class="flex flex-col space-y-1.5 text-sm font-bold text-[#124A6E]">
      <a 
        href="/#planos" 
        onclick="toggleMobileMenu(false)"
        class="flex items-center gap-3 p-3 rounded-xl hover:bg-slate-50 transition-colors"
      >
        <span class="w-8 h-8 rounded-lg bg-[#3DB5B4]/15 text-[#3DB5B4] flex items-center justify-center">
          <span class="iconify w-5 h-5" data-icon="solar:document-text-bold"></span>
        </span>
        Consultas e Pacotes
      </a>

      <a 
        href="/#como-funciona" 
        onclick="toggleMobileMenu(false)"
        class="flex items-center gap-3 p-3 rounded-xl hover:bg-slate-50 transition-colors"
      >
        <span class="w-8 h-8 rounded-lg bg-[#3DB5B4]/15 text-[#3DB5B4] flex items-center justify-center">
          <span class="iconify w-5 h-5" data-icon="solar:settings-bold"></span>
        </span>
        Como Funciona
      </a>

      <a 
        href="/#garantia" 
        onclick="toggleMobileMenu(false)"
        class="flex items-center gap-3 p-3 rounded-xl hover:bg-slate-50 transition-colors"
      >
        <span class="w-8 h-8 rounded-lg bg-[#3DB5B4]/15 text-[#3DB5B4] flex items-center justify-center">
          <span class="iconify w-5 h-5" data-icon="solar:verified-check-bold"></span>
        </span>
        Garantia
      </a>
    </nav>

    <div class="pt-3 border-t border-slate-100">
      <Button 
        href="#hero-form" 
        onclick="toggleMobileMenu(false)"
        variant="primary" 
        size="md" 
        fullWidth 
        icon="solar:magnifier-linear"
      >
        Consultar Placa Agora
      </Button>
    </div>
  </div>
</div>

<script is:inline>
  function handleHeaderLoginClick() {
    const savedUser = localStorage.getItem('documentalista_user');
    if (savedUser) {
      window.location.href = '/painel';
    } else {
      if (typeof openCheckoutModal === 'function') {
        openCheckoutModal();
        if (typeof setCheckoutStep === 'function') setCheckoutStep(2);
        if (typeof switchAuthTab === 'function') switchAuthTab('login');
      } else {
        window.location.href = '/painel';
      }
    }
  }

  function updateHeaderUserButton() {
    const savedUser = localStorage.getItem('documentalista_user');
    const label = document.getElementById('header-user-label');
    if (savedUser && label) {
      try {
        const user = JSON.parse(savedUser);
        label.textContent = user.name ? user.name.split(' ')[0] : 'Meu Painel';
      } catch (e) {
        label.textContent = 'Meu Painel';
      }
    }
  }

  function toggleMobileMenu(forceState) {
    const backdrop = document.getElementById('mobile-menu-backdrop');
    const drawer = document.getElementById('mobile-menu-drawer');
    const toggleBtn = document.getElementById('mobile-menu-toggle');

    if (!backdrop || !drawer) return;

    const isHidden = drawer.classList.contains('hidden');
    const shouldOpen = forceState !== undefined ? forceState : isHidden;

    const hamburgerIcon = '<svg class="w-7 h-7 text-[#124A6E]" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M4 6h16M4 12h16M4 18h16"></path></svg>';
    const closeIcon = '<svg class="w-7 h-7 text-[#124A6E]" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M6 18L18 6M6 6l12 12"></path></svg>';

    if (shouldOpen) {
      backdrop.classList.remove('hidden');
      drawer.classList.remove('hidden');
      setTimeout(() => {
        drawer.classList.remove('-translate-y-4', 'opacity-0');
        drawer.classList.add('translate-y-0', 'opacity-100');
      }, 10);
      if (toggleBtn) {
        toggleBtn.innerHTML = closeIcon;
      }
    } else {
      drawer.classList.remove('translate-y-0', 'opacity-100');
      drawer.classList.add('-translate-y-4', 'opacity-0');
      setTimeout(() => {
        backdrop.classList.add('hidden');
        drawer.classList.add('hidden');
      }, 300);
      if (toggleBtn) {
        toggleBtn.innerHTML = hamburgerIcon;
      }
    }
  }

  document.addEventListener('DOMContentLoaded', updateHeaderUserButton);
  document.addEventListener('astro:page-load', updateHeaderUserButton);
  window.handleHeaderLoginClick = handleHeaderLoginClick;
  window.updateHeaderUserButton = updateHeaderUserButton;
  window.toggleMobileMenu = toggleMobileMenu;
</script>
