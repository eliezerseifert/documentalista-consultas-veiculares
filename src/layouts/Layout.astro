---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import WhatsAppButton from '../components/WhatsAppButton.astro';
import CheckoutModal from '../components/CheckoutModal.astro';
import { ClientRouter } from 'astro:transitions';

interface Props {
  title?: string;
  description?: string;
}

const { 
  title = "DOCUMENTALISTA CONSULTAS — Consulta Veicular por Placa | Histórico Completo, Leilão e Sinistro",
  description = "Consulte o histórico completo do seu veículo pela placa em segundos. Verifique histórico de sinistro, leilão, roubo/furto, restrições, gravame, multas e Tabela FIPE antes de comprar!"
} = Astro.props;
---

<!DOCTYPE html>
<html class="scroll-smooth" lang="pt-BR">
<head>
<meta charset="utf-8"/>
<meta content="width=device-width, initial-scale=1.0" name="viewport"/>
<title>{title}</title>

<!-- Habilita View Transitions do Astro para Navegação Fluída Sem Flicker -->
<ClientRouter />

<!-- Favicon -->
<link rel="icon" type="image/png" href="/favicon.png" />
<link rel="icon" type="image/x-icon" href="/favicon.ico" />

<!-- Meta SEO Best Practices -->
<meta name="description" content={description}/>
<meta name="keywords" content="consulta veicular, consulta placa, histórico de veículo, leilão, sinistro, gravame, consultar renavam, fipe, multas detran, documentalista consultas"/>
<meta name="author" content="Documentalista Consultas"/>
<meta property="og:title" content="DOCUMENTALISTA CONSULTAS — Evite Golpes na Compra do Carro Usado"/>
<meta property="og:description" content="Saiba se o carro tem leilão, sinistro ou multas antes de fechar negócio. Relatório veicular instantâneo por placa."/>
<meta property="og:type" content="website"/>

<!-- Icons & Scripts do Design System -->
<script is:inline src="https://cdn.tailwindcss.com"></script>
<script is:inline src="https://code.iconify.design/3/3.1.0/iconify.min.js"></script>
<script is:inline src="https://unpkg.com/lucide@latest"></script>
<script is:inline src="https://cdn.jsdelivr.net/npm/ogl@1.0.11/dist/ogl.umd.js"></script>

<!-- Google Fonts oficiais do Design System (Poppins & Space Mono) -->
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Poppins:ital,wght@0,300;0,400;0,500;0,600;0,700;0,800;1,300;1,400;1,600&family=Space+Mono:wght@400;700&display=swap" rel="stylesheet">

<style is:global>
:root {
  /* Tokens de Cor Oficiais — Design System Documentalista */
  --color-primary: #3DB5B4;
  --color-primary-rgb: 61, 181, 180;
  --color-secondary: #124A6E;
  --color-secondary-rgb: 18, 74, 110;
  --color-tertiary: #8BA3B5;
  --color-tertiary-rgb: 139, 163, 181;
  --color-emerald-price: #10B981;
  
  /* Definições de Grid e Beams */
  --gx-1: 6%;
  --gx-2: 26%;
  --gx-3: 64%;
  --gx-4: 94%;
  --gy-1: 90px;
  --grid-color: rgba(18, 74, 110, 0.06);
  --beam-color: #3DB5B4;
}

body { 
  font-family: 'Poppins', sans-serif; 
  background-color: #ffffff;
  color: #0f172a;
}

/* Respeito a preferência de movimento reduzido (prefers-reduced-motion) */
@media (prefers-reduced-motion: reduce) {
  #hero-video {
    display: none !important;
  }
}

h1, h2, h3, h4, h5, h6, .font-heading { 
  font-family: 'Poppins', sans-serif; 
}

.font-mono-code {
  font-family: 'Space Mono', monospace;
}

/* Botões com bordas levemente arredondadas (rounded-xl) */
button, .btn, .btn-shimmer, a.btn, a.btn-shimmer, input[type="button"], input[type="submit"] {
  border-radius: 12px;
}

/* Destaque para Valores em Verde */
.price-green {
  color: #10B981;
}

/* Color Classes Utilitárias */
.text-clinimedic-primary { color: #3DB5B4; }
.bg-clinimedic-primary { background-color: #3DB5B4; }
.border-clinimedic-primary { border-color: #3DB5B4; }

.text-clinimedic-secondary { color: #124A6E; }
.bg-clinimedic-secondary { background-color: #124A6E; }
.border-clinimedic-secondary { border-color: #124A6E; }

.text-clinimedic-tertiary { color: #8BA3B5; }
.bg-clinimedic-tertiary { background-color: #8BA3B5; }
.border-clinimedic-tertiary { border-color: #8BA3B5; }

/* Gradients */
.bg-gradient-clinimedic {
  background: linear-gradient(135deg, #124A6E 0%, #3DB5B4 100%);
}
.bg-gradient-clinimedic-soft {
  background: linear-gradient(135deg, rgba(18, 74, 110, 0.04) 0%, rgba(61, 181, 180, 0.08) 100%);
}
.text-gradient-clinimedic {
  background: linear-gradient(135deg, #124A6E 0%, #3DB5B4 100%);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
}

/* Lettering Transparente & Outlines */
.text-stroke-secondary {
  -webkit-text-stroke: 1.5px #124A6E;
  color: transparent;
}
.text-stroke-primary {
  -webkit-text-stroke: 1.5px #3DB5B4;
  color: transparent;
}

/* Watermark Text Background */
.watermark-text {
  font-family: 'Poppins', sans-serif;
  font-weight: 800;
  -webkit-text-stroke: 1.5px rgba(18, 74, 110, 0.04);
  color: transparent;
  user-select: none;
  pointer-events: none;
  letter-spacing: 0.04em;
  text-transform: uppercase;
}

/* Lines & Beams do Grid Background */
.grid-line-v {
  position: absolute;
  top: 0; bottom: 0;
  width: 1px;
  background: var(--grid-color);
  z-index: 0;
}
.grid-line-h {
  position: absolute;
  left: 0; right: 0;
  height: 1px;
  background: var(--grid-color);
  z-index: 0;
}

@keyframes beam-h {
  0% { left: -200px; opacity: 0; }
  10% { opacity: 1; }
  90% { opacity: 1; }
  100% { left: 100%; opacity: 0; }
}
@keyframes beam-v {
  0% { top: -200px; opacity: 0; }
  10% { opacity: 1; }
  90% { opacity: 1; }
  100% { top: 100%; opacity: 0; }
}
.beam-h {
  position: absolute;
  height: 1.5px;
  width: 220px;
  background: linear-gradient(90deg, transparent, #3DB5B4, transparent);
  z-index: 10;
  opacity: 0;
}
.beam-v {
  position: absolute;
  width: 1.5px;
  height: 220px;
  background: linear-gradient(180deg, transparent, #3DB5B4, transparent);
  z-index: 10;
  opacity: 0;
}

/* Animations */
@keyframes reveal-up {
  0% { clip-path: inset(100% 0 0 0); transform: translateY(24px); opacity: 0; }
  100% { clip-path: inset(0 0 0 0); transform: translateY(0); opacity: 1; }
}
@keyframes pulse-glow {
  0%, 100% { box-shadow: 0 0 0 0 rgba(61, 181, 180, 0.4); }
  50% { box-shadow: 0 0 25px 6px rgba(61, 181, 180, 0.5); }
}

.animate-reveal {
  opacity: 0;
  animation: reveal-up 0.9s cubic-bezier(0.16, 1, 0.3, 1) forwards;
}
.animate-pulse-glow {
  animation: pulse-glow 3s infinite;
}

.scroll-reveal {
  opacity: 0;
  transform: translateY(24px);
  transition: all 0.9s cubic-bezier(0.16, 1, 0.3, 1);
}
.scroll-reveal.is-visible {
  opacity: 1;
  transform: translateY(0);
}

.delay-100 { animation-delay: 0.1s; transition-delay: 0.1s; }
.delay-200 { animation-delay: 0.2s; transition-delay: 0.2s; }
.delay-300 { animation-delay: 0.3s; transition-delay: 0.3s; }
.delay-400 { animation-delay: 0.4s; transition-delay: 0.4s; }

/* Button Shimmer Effect */
.btn-shimmer {
  position: relative;
  overflow: hidden;
}
.btn-shimmer::after {
  content: '';
  position: absolute;
  top: -50%;
  left: -50%;
  width: 200%;
  height: 200%;
  background: linear-gradient(
    60deg,
    transparent 30%,
    rgba(255, 255, 255, 0.35) 50%,
    transparent 70%
  );
  transform: rotate(30deg) translateX(-100%);
  transition: transform 0.8s ease;
}
.btn-shimmer:hover::after {
  transform: rotate(30deg) translateX(100%);
}

/* Teaser Blur Overlay */
.blur-teaser {
  filter: blur(5px);
  user-select: none;
  pointer-events: none;
}

/* Brazilian License Plate Styled Container */
.plate-input-container {
  background: #ffffff;
  border: 3px solid #124A6E;
  border-radius: 12px;
  box-shadow: 0 10px 25px -5px rgba(18, 74, 110, 0.15);
  overflow: hidden;
  transition: all 0.3s ease;
}
.plate-input-container:focus-within {
  border-color: #3DB5B4;
  box-shadow: 0 0 0 4px rgba(61, 181, 180, 0.25), 0 12px 30px -5px rgba(61, 181, 180, 0.2);
}
.plate-header-mercosul {
  background: #124A6E;
  color: #ffffff;
  padding: 4px 12px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  font-family: 'Space Mono', monospace;
  font-size: 11px;
  font-weight: 700;
  letter-spacing: 2px;
}

/* Ticket Coupon Design */
.ticket-coupon {
  background: #f0fdf4;
  border: 1.5px dashed #10b981;
  border-radius: 12px;
  position: relative;
}
.ticket-coupon::before, .ticket-coupon::after {
  content: '';
  position: absolute;
  top: 50%;
  width: 12px;
  height: 12px;
  background-color: #ffffff;
  border-radius: 50%;
  transform: translateY(-50%);
}
.ticket-coupon::before { left: -7px; border-right: 1.5px solid #10b981; }
.ticket-coupon::after { right: -7px; border-left: 1.5px solid #10b981; }
</style>
</head>

<body class="bg-white text-slate-900 min-h-screen w-full selection:bg-[#3DB5B4]/20 selection:text-[#124A6E] relative overflow-x-hidden antialiased">
  <Header transition:persist />
  <slot />
  <Footer />
  <WhatsAppButton transition:persist />
  <CheckoutModal transition:persist />
</body>
</html>
