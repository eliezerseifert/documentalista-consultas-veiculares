---
import Layout from '../layouts/Layout.astro';
import Button from '../components/Button.astro';
import PlanCard from '../components/PlanCard.astro';
import FeaturedPlanSection from '../components/FeaturedPlanSection.astro';

const plans = [
  {
    id: 'veiculo-completo',
    title: 'Veículo Completo',
    description: 'A consulta mais completa do mercado, com informações e dados exclusivos, que só o Documentalista tem!',
    originalPrice: 'R$ 69,90',
    price: 'R$ 49,90',
    badge: 'Popular',
    featured: true,
    delay: 'delay-100'
  },
  {
    id: 'veiculo-essencial',
    title: 'Veículo Essencial',
    description: 'Informações essenciais sobre o veículo, que te ajudam a negociar com mais segurança e acertar na escolha do seu próximo carro.',
    originalPrice: 'R$ 52,90',
    price: 'R$ 39,90',
    delay: 'delay-200'
  },
  {
    id: 'leilao-dados',
    title: 'Leilão + Dados do Veículo',
    description: 'Informações sobre o veículo de leilão, que te ajudam a negociar o melhor valor e evitar prejuízos!',
    originalPrice: 'R$ 34,90',
    price: 'R$ 21,90',
    delay: 'delay-300'
  }
];
---

<Layout>
  <main>
    <!-- ========================================== -->
    <!-- 2) HERO SECTION (PRIMEIRA DOBRA) -->
    <!-- ========================================== -->
    <section id="hero-form" class="relative z-10 w-full pt-5 sm:pt-10 pb-6 lg:py-24 overflow-hidden bg-[#0F2D3E]">
      <!-- 1. VÍDEO BACKGROUND EM LOOP -->
      <video 
        id="hero-video"
        autoplay 
        loop 
        muted 
        playsinline 
        preload="metadata"
        class="absolute inset-0 w-full h-full object-cover opacity-50 z-0 pointer-events-none"
      >
        <source src="/images/Men_discussing_vehicle_history_t…_20260915190222.mp4" type="video/mp4" />
      </video>

      <!-- 2. OVERLAY COM DEGRADÊ PROFISSIONAL DA IDENTIDADE VISUAL (#3FB39D -> #1F6790) -->
      <div 
        class="absolute inset-0 z-[1] pointer-events-none"
        style="background: linear-gradient(120deg, rgba(63, 179, 157, 0.80), rgba(31, 103, 144, 0.80));"
      ></div>

      <!-- 3. FADE PROGRESSIVO DA HERO PARA BRANCO NO RODAPÉ DA DOBRA (#FFFFFF) -->
      <div 
        class="absolute inset-x-0 bottom-0 h-28 sm:h-60 z-[2] pointer-events-none"
        style="background: linear-gradient(to bottom, transparent 25%, rgba(255, 255, 255, 0.5) 70%, rgba(255, 255, 255, 0.9) 88%, #FFFFFF 100%);"
      ></div>

      <div class="max-w-[1400px] mx-auto px-6 lg:px-[6%] relative z-10">
        
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-4 lg:gap-12 items-center">
          
          <!-- Coluna Esquerda: Copywriting de Conversão (CRO) -->
          <div class="lg:col-span-7 flex flex-col justify-center">
            
            <!-- Badge de Prova e Status Live (Apenas Desktop) -->
            <div class="hidden lg:inline-flex items-center gap-2.5 px-3.5 py-1.5 rounded-full bg-white/15 border border-white/25 text-white text-[11px] font-bold uppercase tracking-widest mb-6 w-max animate-reveal delay-100 shadow-sm backdrop-blur-sm">
              <span class="relative flex h-2.5 w-2.5">
                <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75"></span>
                <span class="relative inline-flex rounded-full h-2.5 w-2.5 bg-emerald-400"></span>
              </span>
              Mais de 10 anos de experiência com Despachantes de Veículos
            </div>

            <!-- Badge +10 Anos de Experiência (Apenas Mobile - Estilo Pill Capsule conforme print) -->
            <div class="flex justify-center mb-2.5 lg:hidden animate-reveal delay-100">
              <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-white/15 border border-white/25 text-white text-[11px] font-bold uppercase tracking-widest shadow-sm backdrop-blur-sm">
                <span class="relative flex h-2.5 w-2.5">
                  <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75"></span>
                  <span class="relative inline-flex rounded-full h-2.5 w-2.5 bg-emerald-400"></span>
                </span>
                +10 Anos de Experiência
              </div>
            </div>

            <!-- Headline Principal Orientada a Risco/Prejuízo (Centralizada e com Quebras Organizadas no Mobile) -->
            <h1 class="text-2xl sm:text-4xl lg:text-5xl xl:text-[3.25rem] font-extrabold leading-[1.2] sm:leading-[1.15] lg:leading-[1.1] tracking-tight text-white text-center lg:text-left mb-3 lg:mb-0 animate-reveal delay-100 drop-shadow-sm">
              Evite Golpes e Prejuízos <br class="sm:hidden" />
              de até <span class="text-emerald-300 font-extrabold">R$ 50 mil</span> ao <br class="sm:hidden" />
              Comprar um Carro Usado
            </h1>

            <!-- Subheadline Descritiva (Apenas Desktop) -->
            <p class="hidden lg:block text-base lg:text-lg text-slate-100 font-normal leading-relaxed mt-5 max-w-2xl animate-reveal delay-200 text-shadow-sm">
              Saiba a verdade sobre o veículo antes de pagar o sinal. Verifique histórico de <strong class="text-white font-semibold">sinistro (batidas)</strong>, <strong class="text-white font-semibold">leilão com fotos</strong>, roubo/furto, restrições, gravame e débitos apenas digitando a placa.
            </p>

            <!-- Badges de Benefícios Rápidos (Apenas Desktop) -->
            <div class="hidden lg:grid grid-cols-2 sm:grid-cols-3 gap-3 mt-8 animate-reveal delay-300">
              <div class="flex items-center gap-2 bg-white/15 backdrop-blur-md p-2.5 rounded-lg border border-white/20 text-white">
                <span class="iconify w-5 h-5 text-emerald-300 flex-shrink-0" data-icon="solar:shield-check-bold"></span>
                <span class="text-xs font-semibold">Relatório 100% Seguro</span>
              </div>
              <div class="flex items-center gap-2 bg-white/15 backdrop-blur-md p-2.5 rounded-lg border border-white/20 text-white">
                <span class="iconify w-5 h-5 text-emerald-300 flex-shrink-0" data-icon="solar:bolt-bold"></span>
                <span class="text-xs font-semibold">Resultado Instantâneo</span>
              </div>
              <div class="flex items-center gap-2 bg-white/15 backdrop-blur-md p-2.5 rounded-lg border border-white/20 text-white col-span-2 sm:col-span-1">
                <span class="iconify w-5 h-5 text-emerald-300 flex-shrink-0" data-icon="solar:camera-minimalistic-bold"></span>
                <span class="text-xs font-semibold">Fotos de Leilão</span>
              </div>
            </div>

            <!-- Micro Prova Social na Hero & Selo '+10 anos de experiência' (Apenas Desktop) -->
            <div class="hidden lg:flex flex-wrap items-center gap-4 sm:gap-5 mt-8 pt-6 border-t border-white/20 animate-reveal delay-400">
              <div class="flex items-center gap-3">
                <div class="flex -space-x-2 overflow-hidden">
                  <span class="inline-block h-8 w-8 rounded-full ring-2 ring-white/50 bg-[#124A6E] text-white text-xs font-bold text-center leading-8">RM</span>
                  <span class="inline-block h-8 w-8 rounded-full ring-2 ring-white/50 bg-[#3DB5B4] text-white text-xs font-bold text-center leading-8">JK</span>
                  <span class="inline-block h-8 w-8 rounded-full ring-2 ring-white/50 bg-[#8BA3B5] text-white text-xs font-bold text-center leading-8">CE</span>
                </div>
                <div>
                  <div class="flex text-amber-300 text-xs items-center">
                    <span class="iconify" data-icon="solar:star-bold"></span>
                    <span class="iconify" data-icon="solar:star-bold"></span>
                    <span class="iconify" data-icon="solar:star-bold"></span>
                    <span class="iconify" data-icon="solar:star-bold"></span>
                    <span class="iconify" data-icon="solar:star-bold"></span>
                    <span class="text-white font-bold ml-1.5 text-xs">4.9/5.0</span>
                  </div>
                  <p class="text-xs text-slate-100">Mais de 150.000 compradores protegidos contra fraudes.</p>
                </div>
              </div>

              <!-- Separador discreto para telas médias/grandes -->
              <div class="hidden sm:block w-px h-8 bg-white/20"></div>

              <!-- Selo ao Lado das Avaliações (em 2 linhas com fundo escuro e alto contraste) -->
              <div class="inline-flex items-center gap-2.5 px-3.5 py-1.5 rounded-xl bg-[#081F2E] border border-amber-400/60 shadow-lg backdrop-blur-md">
                <span class="iconify w-5 h-5 text-amber-400 flex-shrink-0" data-icon="solar:verified-check-bold"></span>
                <div class="text-[11px] font-extrabold leading-tight tracking-wide text-amber-300">
                  <span class="block">+10 anos de</span>
                  <span class="block">experiência</span>
                </div>
              </div>
            </div>

          </div>

          <!-- Coluna Direita: Card Interativo da Placa de Carro (Formulário CRO) -->
          <div class="lg:col-span-5 animate-reveal delay-200">
            <div class="bg-white/95 backdrop-blur-md p-6 sm:p-8 rounded-2xl border border-slate-200/80 shadow-2xl shadow-slate-300/40 relative z-10">
              
              <div class="flex items-center justify-between mb-4">
                <span class="text-xs font-mono-code text-[#088395] font-bold uppercase tracking-wider flex items-center gap-1.5">
                  <span class="w-2 h-2 rounded-full bg-[#3DB5B4] animate-ping"></span>
                  Consulta de Placa Online
                </span>
                <span class="text-[11px] font-mono-code bg-emerald-50 text-emerald-700 border border-emerald-200 px-2.5 py-0.5 rounded-full font-bold">
                  PRÉVIA GRÁTIS
                </span>
              </div>

              <h2 class="text-xl font-bold text-[#124A6E] mb-2">Digite a placa para consultar</h2>
              <p class="text-xs text-slate-500 mb-6">Aceita padrão Mercosul (ex: ABC1D23) e Antigo (ex: ABC-1234).</p>

              <!-- Box da Placa com Visual do Padrão Mercosul -->
              <form id="vehicle-plate-form" onsubmit="handlePlateSearch(event)" class="space-y-4">
                
                <div class="plate-input-container">
                  <div class="plate-header-mercosul">
                    <span>BRASIL</span>
                    <span class="iconify w-4 h-3" data-icon="flag:br-4x3"></span>
                  </div>
                  <div class="p-3 bg-white flex items-center">
                    <input type="text" 
                           id="plate-input" 
                           maxlength="8" 
                           placeholder="ABC1D23" 
                           required
                           class="w-full text-center text-3xl sm:text-4xl font-mono-code font-bold uppercase text-[#124A6E] tracking-widest focus:outline-none placeholder:text-slate-300"
                           oninput="formatPlateInput(this)"/>
                  </div>
                </div>

                <!-- Mensagem de Erro do Input -->
                <div id="plate-error" class="hidden text-xs text-rose-600 font-semibold flex items-center gap-1">
                  <span class="iconify w-4 h-4" data-icon="solar:danger-circle-bold"></span>
                  Por favor, digite uma placa válida no formato ABC1D23 ou ABC-1234.
                </div>

                <!-- Âncora de Preço Transparente (Valores em Verde Destaque) -->
                <div class="flex items-center justify-between bg-slate-50 p-3.5 rounded-xl border border-slate-200/70 text-xs">
                  <span class="text-slate-600 font-medium">Relatório completo a partir de:</span>
                  <span class="text-base font-extrabold text-emerald-600 font-mono-code">R$ 21,90</span>
                </div>

                <!-- Botão Principal de Conversão -->
                <Button type="submit" id="search-btn" variant="primary" size="lg" fullWidth pulse icon="solar:magnifier-linear">
                  Ver Histórico Deste Carro
                </Button>
              </form>

              <!-- Selos de Confiança e Segurança abaixo do CTA -->
              <div class="mt-6 pt-5 border-t border-slate-100 flex items-center justify-around text-slate-600 text-[11px] font-mono-code">
                <span class="flex items-center gap-1"><span class="iconify text-[#3DB5B4]" data-icon="solar:lock-keyhole-minimalistic-bold"></span> SSL 256-bit</span>
                <span class="flex items-center gap-1"><span class="iconify text-[#3DB5B4]" data-icon="solar:shield-check-bold"></span> LGPD OK</span>
                <span class="flex items-center gap-1"><span class="iconify text-[#3DB5B4]" data-icon="solar:card-bold"></span> Pix / Cartão</span>
              </div>

              <!-- Disclaimer de órgãos públicos -->
              <p class="text-[10px] text-slate-500 text-center mt-3">
                * O Documentalista é um serviço privado. Não possui vínculo direto com o Detran/Denatran.
              </p>

            </div>
          </div>

        </div>

      </div>
    </section>

    <!-- ========================================== -->
    <!-- 2.5) SEÇÃO TUDO O QUE OFERECEMOS + DESCONTO + VALORES EM VERDE DESTAQUE -->
    <!-- ========================================== -->
    <FeaturedPlanSection />

    <!-- ========================================== -->
    <!-- 2.7) OPÇÕES DE CONSULTA (CARDS GRID) -->
    <!-- ========================================== -->
    <section id="planos" class="py-16 lg:py-24 bg-slate-50/70 border-t border-slate-200/60 relative scroll-mt-24">
      <div class="max-w-[1400px] mx-auto px-6 lg:px-[6%]">
        
        <div class="text-center max-w-2xl mx-auto mb-16 scroll-reveal">
          <span class="ds-label">Opções de Consulta</span>
          <h2 class="text-3xl lg:text-4xl font-bold text-[#124A6E] tracking-tight">
            Escolha a consulta perfeita para o seu veículo
          </h2>
          <p class="text-sm text-slate-500 mt-3">
            Relatórios avulsos sob medida com preço com desconto em destaque.
          </p>
        </div>

        <!-- Grid de 6 Cards (Modularizado via Componente PlanCard) -->
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
          {plans.map((plan) => (
            <PlanCard {...plan} />
          ))}
        </div>

        <!-- Banner Especial para Lojistas e Despachantes -->
        <div class="mt-12 bg-gradient-to-r from-[#124A6E] to-[#0e3c59] p-8 sm:p-10 rounded-3xl text-white shadow-xl flex flex-col md:flex-row items-center justify-between gap-6 scroll-reveal">
          <div>
            <span class="text-[10px] font-mono-code bg-[#3DB5B4] text-[#124A6E] px-3 py-1 rounded-full font-bold uppercase tracking-wider">
              Para Lojistas & Despachantes
            </span>
            <h3 class="text-2xl sm:text-3xl font-extrabold mt-3 mb-2">Plano Lojista Pro (Consultas em Lote)</h3>
            <p class="text-xs sm:text-sm text-slate-200 max-w-2xl">
              Sua loja consulta veículos todos os dias? Assine nosso plano corporativo por apenas <strong class="text-emerald-400 font-mono-code text-base">R$ 99,90/mês</strong> e tenha desconto exclusivo em todas as consultas Master!
            </p>
          </div>
          <Button onclick="addToCart('lojista')" variant="secondary" size="md" class="whitespace-nowrap flex-shrink-0">
            ASSINAR PLANO LOJISTA PRO
          </Button>
        </div>

      </div>
    </section>

    <!-- ========================================== -->
    <!-- 3) PROVA SOCIAL COM RESULTADO NUMÉRICO -->
    <!-- ========================================== -->
    <section class="py-14 bg-white border-b border-slate-200/60 relative">
      <div class="max-w-[1400px] mx-auto px-6 lg:px-[6%]">
        
        <div class="text-center max-w-2xl mx-auto mb-10 scroll-reveal">
          <span class="ds-label">Depoimentos Verificados</span>
          <h2 class="text-2xl sm:text-3xl font-bold text-[#124A6E] tracking-tight">
            Quem consultou antes de comprar, economizou de verdade
          </h2>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
          
          <!-- Depoimento 1 -->
          <div class="bg-slate-50 p-7 rounded-xl border border-slate-200 shadow-sm hover:shadow-md transition-all scroll-reveal delay-100 flex flex-col justify-between">
            <div>
              <div class="flex gap-1 text-amber-400 mb-3">
                <span class="iconify w-4 h-4" data-icon="solar:star-bold"></span>
                <span class="iconify w-4 h-4" data-icon="solar:star-bold"></span>
                <span class="iconify w-4 h-4" data-icon="solar:star-bold"></span>
                <span class="iconify w-4 h-4" data-icon="solar:star-bold"></span>
                <span class="iconify w-4 h-4" data-icon="solar:star-bold"></span>
              </div>
              <p class="text-xs sm:text-sm text-slate-600 leading-relaxed mb-4">
                "Estava prestes a dar R$ 55 mil num SUV aparentemente impecável. A consulta no Documentalista revelou <strong class="text-[#124A6E]">sinistro de R$ 32 mil por colisão frontal</strong>. O vendedor não havia contado. Economizei uma fortuna!"
              </p>
            </div>
            <div class="flex items-center gap-3 border-t border-slate-200/60 pt-4 mt-2">
              <div class="w-9 h-9 rounded-full bg-[#124A6E] text-white flex items-center justify-center text-xs font-bold font-mono-code">
                RM
              </div>
              <div>
                <p class="text-xs font-bold text-[#124A6E]">Ricardo M.</p>
                <p class="text-[10px] text-slate-600 font-medium">São Paulo / SP • Economizou R$ 32.000</p>
              </div>
            </div>
          </div>

          <!-- Depoimento 2 -->
          <div class="bg-slate-50 p-7 rounded-xl border border-slate-200 shadow-sm hover:shadow-md transition-all scroll-reveal delay-200 flex flex-col justify-between">
            <div>
              <div class="flex gap-1 text-amber-400 mb-3">
                <span class="iconify w-4 h-4" data-icon="solar:star-bold"></span>
                <span class="iconify w-4 h-4" data-icon="solar:star-bold"></span>
                <span class="iconify w-4 h-4" data-icon="solar:star-bold"></span>
                <span class="iconify w-4 h-4" data-icon="solar:star-bold"></span>
                <span class="iconify w-4 h-4" data-icon="solar:star-bold"></span>
              </div>
              <p class="text-xs sm:text-sm text-slate-600 leading-relaxed mb-4">
                "Ia comprar um Hatch seminovo. Ao puxar a placa, vi as <strong class="text-[#124A6E]">fotos do leilão com a lateral destruída</strong> e restrição financeira de gravame. O relatório me livrou de uma enorme dor de cabeça."
              </p>
            </div>
            <div class="flex items-center gap-3 border-t border-slate-200/60 pt-4 mt-2">
              <div class="w-9 h-9 rounded-full bg-[#3DB5B4] text-white flex items-center justify-center text-xs font-bold font-mono-code">
                JK
              </div>
              <div>
                <p class="text-xs font-bold text-[#124A6E]">Juliana K.</p>
                <p class="text-[10px] text-slate-600 font-medium">Curitiba / PR • Evitou golpe de leilão</p>
              </div>
            </div>
          </div>

          <!-- Depoimento 3 -->
          <div class="bg-slate-50 p-7 rounded-xl border border-slate-200 shadow-sm hover:shadow-md transition-all scroll-reveal delay-300 flex flex-col justify-between">
            <div>
              <div class="flex gap-1 text-amber-400 mb-3">
                <span class="iconify w-4 h-4" data-icon="solar:star-bold"></span>
                <span class="iconify w-4 h-4" data-icon="solar:star-bold"></span>
                <span class="iconify w-4 h-4" data-icon="solar:star-bold"></span>
                <span class="iconify w-4 h-4" data-icon="solar:star-bold"></span>
                <span class="iconify w-4 h-4" data-icon="solar:star-bold"></span>
              </div>
              <p class="text-xs sm:text-sm text-slate-600 leading-relaxed mb-4">
                "Trabalho com revenda de seminovos. Faço o relatório do Documentalista para todos os carros do estoque e entrego impresso ao cliente. Passa 100% de confiança e acelera o fechamento!"
              </p>
            </div>
            <div class="flex items-center gap-3 border-t border-slate-200/60 pt-4 mt-2">
              <div class="w-9 h-9 rounded-full bg-[#8BA3B5] text-white flex items-center justify-center text-xs font-bold font-mono-code">
                CE
              </div>
              <div>
                <p class="text-xs font-bold text-[#124A6E]">Carlos E.</p>
                <p class="text-[10px] text-slate-600 font-medium">Belo Horizonte / MG • Lojista parceiro</p>
              </div>
            </div>
          </div>

        </div>

      </div>
    </section>

    <!-- ========================================== -->
    <!-- 4) COMO FUNCIONA (3 PASSOS SIMPLES) -->
    <!-- ========================================== -->
    <section id="como-funciona" class="py-16 lg:py-24 bg-slate-50/50 relative scroll-mt-24">
      <div class="max-w-[1400px] mx-auto px-6 lg:px-[6%]">
        
        <div class="text-center max-w-2xl mx-auto mb-16 scroll-reveal">
          <span class="ds-label">Passo a Passo</span>
          <h2 class="text-3xl lg:text-4xl font-bold text-[#124A6E] tracking-tight">
            Como consultar o histórico do carro em 3 minutos
          </h2>
          <p class="text-sm text-slate-500 mt-3">
            Processo 100% digital, sem burocracia e com entrega imediata na tela e no seu WhatsApp.
          </p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-8 relative">
          
          <!-- Passo 1 -->
          <div class="bg-white p-8 rounded-2xl border border-slate-200/80 relative group hover:border-[#3DB5B4] transition-all scroll-reveal delay-100 shadow-sm">
            <div class="w-12 h-12 bg-[#124A6E] text-white rounded-full flex items-center justify-center font-mono-code font-bold text-lg mb-6 shadow-md">
              1
            </div>
            <h3 class="text-lg font-bold text-[#124A6E] mb-2">Digite a Placa</h3>
            <p class="text-xs text-slate-600 leading-relaxed">
              Informe a placa do veículo no campo de busca no topo da página. Aceitamos padrão antigo e Mercosul.
            </p>
          </div>

          <!-- Passo 2 -->
          <div class="bg-white p-8 rounded-2xl border border-slate-200/80 relative group hover:border-[#3DB5B4] transition-all scroll-reveal delay-200 shadow-sm">
            <div class="w-12 h-12 bg-[#3DB5B4] text-white rounded-full flex items-center justify-center font-mono-code font-bold text-lg mb-6 shadow-md">
              2
            </div>
            <h3 class="text-lg font-bold text-[#124A6E] mb-2">Confira a Prévia Grátis</h3>
            <p class="text-xs text-slate-600 leading-relaxed">
              O sistema valida os dados do modelo e ano do veículo instantaneamente para garantir que você consulte o carro certo.
            </p>
          </div>

          <!-- Passo 3 -->
          <div class="bg-white p-8 rounded-2xl border border-slate-200/80 relative group hover:border-[#3DB5B4] transition-all scroll-reveal delay-300 shadow-sm">
            <div class="w-12 h-12 bg-[#8BA3B5] text-white rounded-full flex items-center justify-center font-mono-code font-bold text-lg mb-6 shadow-md">
              3
            </div>
            <h3 class="text-lg font-bold text-[#124A6E] mb-2">Receba o Laudo Completo</h3>
            <p class="text-xs text-slate-600 leading-relaxed">
              Após a confirmação via Pix ou cartão, o relatório completo fica disponível imediatamente em PDF e no seu e-mail.
            </p>
          </div>

        </div>

      </div>
    </section>

    <!-- ========================================== -->
    <!-- 7) GARANTIA E SEGURANÇA -->
    <!-- ========================================== -->
    <section id="garantia" class="py-16 bg-white border-y border-slate-200/60 relative">
