  <script is:inline>
    // Dicionário de Planos / Consultas Disponíveis
    const PRODUCTS_CATALOG = {
      'veiculo-completo': { id: 'veiculo-completo', name: 'Veículo Completo', originalPrice: 69.90, price: 49.90 },
      'veiculo-essencial': { id: 'veiculo-essencial', name: 'Veículo Essencial', originalPrice: 52.90, price: 39.90 },
      'leilao-dados': { id: 'leilao-dados', name: 'Leilão + Dados do Veículo', originalPrice: 34.90, price: 21.90 },
      'lojista': { id: 'lojista', name: 'Plano Lojista Pro (Mensal)', originalPrice: 149.90, price: 99.90 }
    };

    // Estado Global do Carrinho
    let cartItems = [];
    let appliedDiscountPercent = 0;
    let activeCouponCode = '';

    document.addEventListener('DOMContentLoaded', () => {
      if (window.lucide) {
        window.lucide.createIcons();
      }

      // Scroll Reveal Observer
      const observerOptions = { root: null, rootMargin: '0px', threshold: 0.1 };
      const observer = new IntersectionObserver((entries, obs) => {
        entries.forEach(entry => {
          if (entry.isIntersecting) {
            entry.target.classList.add('is-visible');
            obs.unobserve(entry.target);
          }
        });
      }, observerOptions);

      document.querySelectorAll('.scroll-reveal').forEach(el => observer.observe(el));

      renderCartUI();
      initAuroraBackground();
    });

    // EFEITO AURORA WEBGL SHADER
    function initAuroraBackground() {
      const ctn = document.getElementById('aurora-container');
      if (!ctn || typeof OGL === 'undefined') return;

      const { Renderer, Program, Mesh, Color, Triangle } = OGL;

      const VERT = `#version 300 es
in vec2 position;
void main() {
  gl_Position = vec4(position, 0.0, 1.0);
}
`;

      const FRAG = `#version 300 es
precision highp float;

uniform float uTime;
uniform float uAmplitude;
uniform vec3 uColorStops[3];
uniform vec2 uResolution;
uniform float uBlend;
uniform float uLightMode;

out vec4 fragColor;

vec3 permute(vec3 x) {
  return mod(((x * 34.0) + 1.0) * x, 289.0);
}

float snoise(vec2 v){
  const vec4 C = vec4(
      0.211324865405187, 0.366025403784439,
      -0.577350269189626, 0.024390243902439
  );
  vec2 i  = floor(v + dot(v, C.yy));
  vec2 x0 = v - i + dot(i, C.xx);
  vec2 i1 = (x0.x > x0.y) ? vec2(1.0, 0.0) : vec2(0.0, 1.0);
  vec4 x12 = x0.xyxy + C.xxzz;
  x12.xy -= i1;
  i = mod(i, 289.0);

  vec3 p = permute(
      permute(i.y + vec3(0.0, i1.y, 1.0))
    + i.x + vec3(0.0, i1.x, 1.0)
  );

  vec3 m = max(
      0.5 - vec3(
          dot(x0, x0),
          dot(x12.xy, x12.xy),
          dot(x12.zw, x12.zw)
      ), 
      0.0
  );
  m = m * m;
  m = m * m;

  vec3 x = 2.0 * fract(p * C.www) - 1.0;
  vec3 h = abs(x) - 0.5;
  vec3 ox = floor(x + 0.5);
  vec3 a0 = x - ox;
  m *= 1.79284291400159 - 0.85373472095314 * (a0*a0 + h*h);

  vec3 g;
  g.x  = a0.x  * x0.x  + h.x  * x0.y;
  g.yz = a0.yz * x12.xz + h.yz * x12.yw;
  return 130.0 * dot(m, g);
}

struct ColorStop {
  vec3 color;
  float position;
};

#define COLOR_RAMP(colors, factor, finalColor) {              \
  int index = 0;                                            \
  for (int i = 0; i < 2; i++) {                               \
     ColorStop currentColor = colors[i];                    \
     bool isInBetween = currentColor.position <= factor;    \
     index = int(mix(float(index), float(i), float(isInBetween))); \
  }                                                         \
  ColorStop currentColor = colors[index];                   \
  ColorStop nextColor = colors[index + 1];                  \
  float range = nextColor.position - currentColor.position; \
  float lerpFactor = (factor - currentColor.position) / range; \
  finalColor = mix(currentColor.color, nextColor.color, lerpFactor); \
}

void main() {
  vec2 uv = gl_FragCoord.xy / uResolution;
  
  ColorStop colors[3];
  colors[0] = ColorStop(uColorStops[0], 0.0);
  colors[1] = ColorStop(uColorStops[1], 0.5);
  colors[2] = ColorStop(uColorStops[2], 1.0);
  
  vec3 rampColor;
  COLOR_RAMP(colors, uv.x, rampColor);
  
  float height = snoise(vec2(uv.x * 2.2 + uTime * 0.12, uTime * 0.28)) * 0.65 * uAmplitude;
  height = exp(height);
  height = (uv.y * 2.0 - height + 0.15);
  float intensity = 0.85 * height;
  
  float midPoint = 0.12;
  float auroraAlpha = smoothstep(midPoint - uBlend * 0.4, midPoint + uBlend * 0.4, intensity);
  
  vec3 auroraColor = clamp(rampColor * (0.9 + 0.5 * intensity), 0.0, 1.0);
  float alpha = clamp(auroraAlpha * 0.75, 0.0, 0.85);
  
  fragColor = vec4(auroraColor * alpha, alpha);
}
`;

    try {
      const renderer = new Renderer({
        alpha: true,
        premultipliedAlpha: true,
        antialias: true
      });
      const gl = renderer.gl;
      gl.clearColor(0, 0, 0, 0);
      gl.enable(gl.BLEND);
      gl.blendFunc(gl.ONE, gl.ONE_MINUS_SRC_ALPHA);
      gl.canvas.style.backgroundColor = 'transparent';
      gl.canvas.style.width = '100%';
      gl.canvas.style.height = '100%';
      gl.canvas.style.display = 'block';

      let program;

      function resize() {
        if (!ctn) return;
        const width = ctn.offsetWidth || window.innerWidth;
        const height = ctn.offsetHeight || 600;
        renderer.setSize(width, height);
        if (program) {
          program.uniforms.uResolution.value = [width, height];
        }
      }
      window.addEventListener('resize', resize);

      const geometry = new Triangle(gl);
      if (geometry.attributes.uv) {
        delete geometry.attributes.uv;
      }

      const colorStops = ["#39B49D", "#c9f2ea", "#1F6790"];
      const colorStopsArray = colorStops.map(hex => {
        const c = new Color(hex);
        return [c.r, c.g, c.b];
      });

      program = new Program(gl, {
        vertex: VERT,
        fragment: FRAG,
        uniforms: {
          uTime: { value: 0 },
          uAmplitude: { value: 1.5 },
          uColorStops: { value: colorStopsArray },
          uResolution: { value: [ctn.offsetWidth || window.innerWidth, ctn.offsetHeight || 600] },
          uBlend: { value: 0.5 },
          uLightMode: { value: 0 }
        }
      });

      const mesh = new Mesh(gl, { geometry, program });
      ctn.appendChild(gl.canvas);

      let animateId = 0;
      const speed = 1.25;
      const amplitude = 1.5;
      const blend = 0.5;

      const update = t => {
        animateId = requestAnimationFrame(update);
        const time = t * 0.01;
        program.uniforms.uTime.value = time * speed * 0.1;
        program.uniforms.uAmplitude.value = amplitude;
        program.uniforms.uBlend.value = blend;
        program.uniforms.uLightMode.value = 0;
        renderer.render({ scene: mesh });
      };
      animateId = requestAnimationFrame(update);
      resize();
    } catch (err) {
      console.warn('Aurora WebGL animation initialization error:', err);
    }
  }

  // Formatação de Moeda BRL
  function formatMoney(amount) {
    return amount.toLocaleString('pt-BR', { style: 'currency', currency: 'BRL' });
  }

  // Adicionar Item ao Carrinho e Abrir Drawer
  function addToCart(productId) {
    const product = PRODUCTS_CATALOG[productId];
    if (!product) return;

    const existingIndex = cartItems.findIndex(item => item.id === productId);
    if (existingIndex > -1) {
      cartItems[existingIndex].quantity += 1;
    } else {
      cartItems.push({ ...product, quantity: 1 });
    }

    renderCartUI();
    openCartDrawer();
  }

  // Alterar Quantidade do Item
  function updateQuantity(productId, delta) {
    const index = cartItems.findIndex(item => item.id === productId);
    if (index > -1) {
      cartItems[index].quantity += delta;
      if (cartItems[index].quantity <= 0) {
        cartItems.splice(index, 1);
      }
    }
    renderCartUI();
  }

  // Remover Item do Carrinho
  function removeFromCart(productId) {
    cartItems = cartItems.filter(item => item.id !== productId);
    renderCartUI();
  }

  // Limpar Carrinho Inteiro
  function clearCart() {
    cartItems = [];
    appliedDiscountPercent = 0;
    activeCouponCode = '';
    const input = document.getElementById('coupon-input');
    if (input) input.value = '';
    const msg = document.getElementById('coupon-message');
    if (msg) msg.classList.add('hidden');
    renderCartUI();
  }

  // Aplicar Cupom de Desconto
  function applyCoupon() {
    const input = document.getElementById('coupon-input').value.trim().toUpperCase();
    const msgEl = document.getElementById('coupon-message');

    if (!input) {
      msgEl.textContent = 'Por favor, digite um cupom.';
      msgEl.className = 'text-[11px] font-semibold font-mono-code text-rose-500 block';
      return;
    }

    if (['DOC15', 'PRIMEIRA', 'OLHO10', 'DOCUMENTALISTA'].includes(input)) {
      appliedDiscountPercent = 0.15; // 15% OFF
      activeCouponCode = input;
      msgEl.textContent = `Cupom ${input} aplicado! 15% de desconto garantido.`;
      msgEl.className = 'text-[11px] font-semibold font-mono-code text-emerald-600 block';
    } else {
      msgEl.textContent = 'Cupom inválido ou expirado.';
      msgEl.className = 'text-[11px] font-semibold font-mono-code text-rose-500 block';
    }

    renderCartUI();
  }

  // Renderizar Interface do Carrinho
  function renderCartUI() {
    const container = document.getElementById('cart-items-container');
    const badge = document.getElementById('cart-badge');
    const summaryList = document.getElementById('summary-items-list');
    const totalEl = document.getElementById('cart-total-price');
    const discountRow = document.getElementById('summary-discount-row');
    const discountValueEl = document.getElementById('summary-discount-value');

    if (!container || !badge || !summaryList || !totalEl) return;

    const totalCount = cartItems.reduce((acc, item) => acc + item.quantity, 0);
    badge.textContent = totalCount;

    if (cartItems.length === 0) {
      container.innerHTML = `
        <div class="py-12 text-center text-slate-500 space-y-3">
          <span class="iconify w-12 h-12 mx-auto text-slate-300" data-icon="solar:cart-large-minimalistic-linear"></span>
          <p class="text-xs">Seu carrinho está vazio.</p>
          <button onclick="closeCartDrawer()" class="text-xs font-bold text-[#088395] hover:underline">
            Escolher uma consulta
          </button>
        </div>
      `;
      summaryList.innerHTML = `<p class="italic text-slate-500 text-[11px]">Nenhum item selecionado.</p>`;
      totalEl.textContent = 'R$ 0,00';
      if (discountRow) discountRow.classList.add('hidden');
      return;
    }

    let itemsHTML = '';
    let summaryHTML = '';
    let subtotal = 0;

    cartItems.forEach(item => {
      const itemSubtotal = item.price * item.quantity;
      subtotal += itemSubtotal;

      itemsHTML += `
        <div class="bg-white p-3.5 rounded-xl border border-slate-200 flex items-center justify-between gap-3 shadow-2xs">
          <div class="flex-1">
            <p class="text-xs font-bold text-[#124A6E]">${item.name}</p>
            ${item.originalPrice > 0 ? `
              <p class="text-[10px] text-rose-500 font-semibold line-through">de ${formatMoney(item.originalPrice)} por</p>
              <p class="text-sm font-extrabold text-emerald-600 font-mono-code">${formatMoney(item.price)}</p>
            ` : `
              <p class="text-xs font-extrabold text-emerald-600 font-mono-code">GRÁTIS</p>
            `}
          </div>

          <div class="flex items-center gap-2 bg-slate-50 p-1.5 rounded-lg border border-slate-200">
            <button onclick="removeFromCart('${item.id}')" aria-label="Remover ${item.name} do carrinho" class="text-slate-400 hover:text-rose-500 p-1 transition-colors" title="Remover">
              <span class="iconify w-3.5 h-3.5" data-icon="solar:trash-bin-trash-linear"></span>
            </button>
            <div class="flex items-center gap-1.5 px-1 font-mono-code font-bold text-xs text-[#124A6E]">
              <button onclick="updateQuantity('${item.id}', -1)" aria-label="Diminuir quantidade" class="w-5 h-5 rounded hover:bg-slate-200 flex items-center justify-center text-slate-600">-</button>
              <span>${item.quantity}</span>
              <button onclick="updateQuantity('${item.id}', 1)" aria-label="Aumentar quantidade" class="w-5 h-5 rounded hover:bg-slate-200 flex items-center justify-center text-slate-600">+</button>
            </div>
          </div>
        </div>
      `;

      summaryHTML += `
        <div class="flex justify-between items-center text-[11px]">
          <span>${item.name} (x${item.quantity})</span>
          <span class="font-mono-code font-semibold">${formatMoney(itemSubtotal)}</span>
        </div>
      `;
    });

    container.innerHTML = itemsHTML;
    summaryList.innerHTML = summaryHTML;

    const discountAmount = subtotal * appliedDiscountPercent;
    const finalTotal = subtotal - discountAmount;

    if (discountRow) {
      if (discountAmount > 0) {
        discountRow.classList.remove('hidden');
        if (discountValueEl) discountValueEl.textContent = `- ${formatMoney(discountAmount)}`;
      } else {
        discountRow.classList.add('hidden');
      }
    }

    totalEl.textContent = formatMoney(finalTotal);
  }

  // Abertura e Fechamento do Drawer
  function openCartDrawer() {
    const backdrop = document.getElementById('cart-backdrop');
    const drawer = document.getElementById('cart-drawer');
    if (backdrop) backdrop.classList.remove('hidden');
    if (drawer) drawer.classList.remove('translate-x-full');
  }

  function closeCartDrawer() {
    const backdrop = document.getElementById('cart-backdrop');
    const drawer = document.getElementById('cart-drawer');
    if (backdrop) backdrop.classList.add('hidden');
    if (drawer) drawer.classList.add('translate-x-full');
  }

  // Redirecionamento de Checkout
  function proceedToCheckout() {
    if (cartItems.length === 0) {
      alert('Seu carrinho está vazio. Adicione uma consulta primeiro!');
      return;
    }
    closeCartDrawer();
    openCheckoutModal();
  }

  function selectPlan(planId) {
    addToCart(planId);
  }

  // Formatação em Tempo Real do Input de Placa
  function formatPlateInput(input) {
    let value = input.value.toUpperCase().replace(/[^A-Z0-9]/g, '');
    if (value.length > 3 && /^[A-Z]{3}[0-9]/.test(value)) {
      value = value.substring(0, 3) + '-' + value.substring(3, 7);
    } else {
      value = value.substring(0, 7);
    }
    input.value = value;
    const err = document.getElementById('plate-error');
    if (err) err.classList.add('hidden');
  }

  // Handler de Busca da Placa
  function handlePlateSearch(event) {
    event.preventDefault();
    const inputEl = document.getElementById('plate-input');
    const plateInput = inputEl ? inputEl.value.replace(/[^A-Z0-9]/g, '') : '';
    const errorEl = document.getElementById('plate-error');

    if (plateInput.length !== 7) {
      if (errorEl) errorEl.classList.remove('hidden');
      return;
    }

    openTeaserModal(plateInput);
  }

  // Modal Teaser Controls
  function openTeaserModal(plate) {
    const modal = document.getElementById('teaser-modal');
    const loadingState = document.getElementById('modal-loading-state');
    const resultState = document.getElementById('modal-result-state');
    const loadingText = document.getElementById('loading-status-text');

    if (!modal || !loadingState || !resultState) return;

    modal.classList.remove('hidden');
    loadingState.classList.remove('hidden');
    resultState.classList.add('hidden');

    setTimeout(() => { if (loadingText) loadingText.textContent = "Verificando histórico de sinistro e leilões..."; }, 900);
    setTimeout(() => { if (loadingText) loadingText.textContent = "Gerando prévia do laudo..."; }, 1800);
    setTimeout(() => {
      loadingState.classList.add('hidden');
      resultState.classList.remove('hidden');
    }, 2500);
  }

  function closeTeaserModal() {
    const modal = document.getElementById('teaser-modal');
    if (modal) modal.classList.add('hidden');
  }

  // Accordion FAQ Toggle
  function toggleFaq(button) {
    const content = button.nextElementSibling;
    const icon = button.querySelector('.iconify');
    if (!content) return;
    const isHidden = content.classList.contains('hidden');

    document.querySelectorAll('#faq .px-6.pb-6').forEach(el => el.classList.add('hidden'));
    document.querySelectorAll('#faq .iconify').forEach(el => el.classList.remove('rotate-180'));

    if (isHidden) {
      content.classList.remove('hidden');
      if (icon) icon.classList.add('rotate-180');
    }
  }

  // Expor funções no objeto global window
  window.addToCart = addToCart;
  window.updateQuantity = updateQuantity;
  window.removeFromCart = removeFromCart;
  window.clearCart = clearCart;
  window.applyCoupon = applyCoupon;
  window.openCartDrawer = openCartDrawer;
  window.closeCartDrawer = closeCartDrawer;
  window.proceedToCheckout = proceedToCheckout;
  window.selectPlan = selectPlan;
  window.formatPlateInput = formatPlateInput;
  window.handlePlateSearch = handlePlateSearch;
  window.openTeaserModal = openTeaserModal;
  window.closeTeaserModal = closeTeaserModal;
  window.toggleFaq = toggleFaq;
</script>
</Layout>
