---
import Layout from '../layouts/Layout.astro';
---

<Layout title="DOCUMENTALISTA CONSULTAS — Página Modelo">
  <main class="min-h-[60vh] py-16 lg:py-24 max-w-[1400px] mx-auto px-6 lg:px-[6%]">
    <div class="bg-slate-50 border border-slate-200 rounded-3xl p-8 sm:p-12 text-center max-w-2xl mx-auto shadow-sm">
      <span class="text-xs font-mono-code bg-[#3DB5B4]/15 text-[#124A6E] px-3 py-1 rounded-full font-bold uppercase tracking-wider">
        Página Em Branco
      </span>
      <h1 class="text-3xl font-extrabold text-[#124A6E] mt-4 mb-3">
        Segunda Página
      </h1>
      <p class="text-sm text-slate-500 mb-6">
        Esta página está pronta para receber novos conteúdos e componentes.
      </p>
      <a href="/" class="inline-flex items-center gap-2 bg-[#124A6E] text-white px-6 py-3 rounded-xl font-bold text-sm hover:bg-[#0e3c59] transition-colors">
        Voltar para a Página Inicial
      </a>
    </div>
  </main>
</Layout>
